"""
GridMind — backend/services/shap_cache.py
Loads precomputed SHAP values from backend/cache/shap_values.json
and exposes them for the /explain/{scenario_id} endpoint.
"""

import os
import json
from typing import Dict, Any, Optional

ROOT       = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
CACHE_PATH = os.path.join(ROOT, "backend", "cache", "shap_values.json")

VALID_SCENARIOS = {"industrial_spike", "storm", "battery_depletion", "dual_failure"}

# ---------------------------------------------------------------------------
# Fallback data — used when cache file is absent (e.g. before compute_shap.py runs)
# Values match the schema in PROJECT_STATE.md §15
# ---------------------------------------------------------------------------
