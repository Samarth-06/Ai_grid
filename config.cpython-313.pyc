}


class SHAPCache:
    """
    Loads shap_values.json once at startup and serves it by scenario_id.
    Falls back to hard-coded values if the file is missing.
    """

    def __init__(self, cache_path: str = CACHE_PATH):
        self._cache_path = cache_path
        self._data: Dict[str, Any] = {}
        self._from_file = False
        self._load()

    # ------------------------------------------------------------------
    # Public API
    # ------------------------------------------------------------------

    def get(self, scenario_id: str) -> Optional[Dict[str, Any]]:
        """
        Return SHAP data for a scenario, or None if not found.
        scenario_id: 'industrial_spike' | 'storm' | 'battery_depletion' | 'dual_failure'
        """
        if scenario_id not in VALID_SCENARIOS:
            raise ValueError(
                f"Unknown scenario_id '{scenario_id}'. "
                f"Valid: {sorted(VALID_SCENARIOS)}"
            )
        return self._data.get(scenario_id)

    def get_all(self) -> Dict[str, Any]:
        return dict(self._data)

    def is_from_file(self) -> bool:
        return self._from_file

    def reload(self):
        """Re-read the cache file from disk (call after running compute_shap.py)."""
        self._load()

    # ------------------------------------------------------------------
    # Private
    # ------------------------------------------------------------------

    def _load(self):
        if os.path.exists(self._cache_path):
            try:
                with open(self._cache_path, "r", encoding="utf-8") as f:
                    self._data = json.load(f)
                self._from_file = True
                print(f"[SHAPCache] Loaded {len(self._data)} scenarios from {self._cache_path}")
                return
            except Exception as exc:
                print(f"[SHAPCache] Failed to load cache file ({exc}) — using fallback.")

        self._data = dict(_FALLBACK)
        self._from_file = False
        print("[SHAPCache] Using built-in fallback SHAP values.")


# ---------------------------------------------------------------------------
# Module-level singleton
# ---------------------------------------------------------------------------
_shap_cache_instance: Optional[SHAPCache] = None


def get_shap_cache() -> SHAPCache:
    global _shap_cache_instance
    if _shap_cache_instance is None:
        _shap_cache_instance = SHAPCache()
    return _shap_cache_instance
