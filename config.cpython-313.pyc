        "top_features": [
            {"name": "lag_1h",        "shap_value":  142.3, "direction": "up"},
            {"name": "hour_sin",      "shap_value":   89.1, "direction": "up"},
            {"name": "roll_mean_12h", "shap_value":   71.2, "direction": "up"},
            {"name": "is_weekend",    "shap_value":  -32.1, "direction": "down"},
            {"name": "lag_24h",       "shap_value":   28.5, "direction": "up"},
