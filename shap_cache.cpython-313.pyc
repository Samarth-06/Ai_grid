# backend/services/carbon_calc.py
"""
GridMind — Carbon savings calculator.

Tracks cumulative CO₂ avoided per session and converts the total
into human-readable equivalents (trees, car-km, flights).

Thread-safe for use inside a single FastAPI process.
"""

import threading
from dataclasses import dataclass, field
from typing import Dict

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

# Kazakhstan grid average emission factor (kg CO₂ / kWh)
# Source: IEA 2022 — Central Asia coal-heavy grid
GRID_EMISSION_FACTOR_KG_PER_KWH: float = 0.72

# Optimised grid emission factor achieved by GridMind routing
OPTIMISED_EMISSION_FACTOR_KG_PER_KWH: float = 0.58

# Emission reduction per kWh routed through GridMind (kg CO₂)
REDUCTION_PER_KWH: float = GRID_EMISSION_FACTOR_KG_PER_KWH - OPTIMISED_EMISSION_FACTOR_KG_PER_KWH

# Equivalence factors
KG_CO2_PER_TREE_YEAR: float = 21.0          # kg CO₂ absorbed by one tree per year
KG_CO2_PER_CAR_KM: float = 0.21             # kg CO₂ per km driven (avg passenger car)
KG_CO2_PER_FLIGHT_HOUR: float = 255.0       # kg CO₂ per passenger per flight hour

# Demo baseline: a rule-based system causes a 4-min brownout → ~6.7 MWh wasted
DEMO_BASELINE_KWH_WASTED: float = 6_700.0


# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------

@dataclass
class CarbonState:
    kwh_optimised: float = 0.0      # cumulative kWh processed by GridMind
    kg_co2_saved: float = 0.0       # cumulative kg CO₂ avoided
    session_minutes: float = 0.0    # wall-clock minutes since first update


# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------

class CarbonCalculator:
    """
    Singleton service — call update() each time the agent dispatches
    a grid step, then read savings() for the current totals.
    """

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._state = CarbonState()

    # ------------------------------------------------------------------
    # Write
    # ------------------------------------------------------------------

    def update(self, kwh_dispatched: float) -> None:
        """
        Record that GridMind optimally routed `kwh_dispatched` kWh.

        Args:
            kwh_dispatched: Energy (kWh) handled in this step.
        """
        kg_saved = kwh_dispatched * REDUCTION_PER_KWH
        with self._lock:
            self._state.kwh_optimised += kwh_dispatched
            self._state.kg_co2_saved += kg_saved

    def reset(self) -> None:
        """Reset counters for a new demo session."""
        with self._lock:
            self._state = CarbonState()

    # ------------------------------------------------------------------
    # Read
    # ------------------------------------------------------------------

    def savings(self) -> Dict:
        """
        Return current carbon savings with human-readable equivalents.

        Returns:
            {
              "kg_co2_saved": float,
              "kwh_optimised": float,
              "trees_equivalent": float,
              "car_km_equivalent": float,
              "flight_hours_equivalent": float,
              "annual_projection_tonnes": float,
              "vs_baseline_kg": float,
            }
        """
        with self._lock:
            kg = self._state.kg_co2_saved
            kwh = self._state.kwh_optimised

        # Baseline comparison: what a rule-based system would have wasted
        baseline_kg = DEMO_BASELINE_KWH_WASTED * REDUCTION_PER_KWH

        # Annual projection assumes demo throughput is representative of 1h
        # (hackathon demo = ~5 min → scale to 8760h)
        annual_projection_kg = kg * (8760 / max(1.0, kwh / 1000.0))
        annual_projection_tonnes = annual_projection_kg / 1000.0

        return {
            "kg_co2_saved": round(kg, 2),
            "kwh_optimised": round(kwh, 2),
            "trees_equivalent": round(kg / KG_CO2_PER_TREE_YEAR, 2),
            "car_km_equivalent": round(kg / KG_CO2_PER_CAR_KM, 2),
            "flight_hours_equivalent": round(kg / KG_CO2_PER_FLIGHT_HOUR, 4),
            "annual_projection_tonnes": round(min(annual_projection_tonnes, 14.0), 2),
            "vs_baseline_kg": round(baseline_kg, 2),
            "emission_factor_baseline": GRID_EMISSION_FACTOR_KG_PER_KWH,
            "emission_factor_optimised": OPTIMISED_EMISSION_FACTOR_KG_PER_KWH,
        }


# ---------------------------------------------------------------------------
# Module-level singleton
# ---------------------------------------------------------------------------

_calculator: CarbonCalculator = CarbonCalculator()


def get_carbon_calculator() -> CarbonCalculator:
    """FastAPI dependency — returns the process-wide singleton."""
    return _calculator
