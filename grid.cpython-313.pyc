# backend/routers/scenario.py
"""
GridMind — POST /scenario

Injects one of the 4 demo scenarios into the grid state machine.
Also resets carbon counters and returns the resulting grid state.
"""

import logging
from datetime import datetime, timezone
from typing import Literal

from fastapi import APIRouter, Depends, HTTPException
from pydantic import BaseModel, field_validator

from backend.config import Settings, get_settings
from backend.services.scenario_engine import (
    ScenarioEngine,
    VALID_SCENARIOS,
    SCENARIO_LABELS,
    get_scenario_engine,
)
from backend.services.carbon_calc import CarbonCalculator, get_carbon_calculator

logger = logging.getLogger(__name__)
router = APIRouter(prefix="/scenario", tags=["scenario"])


# ---------------------------------------------------------------------------
# Request / Response schemas
# ---------------------------------------------------------------------------

class ScenarioRequest(BaseModel):
    scenario_id: str
    language: Literal["en", "kz", "ru"] = "en"

    @field_validator("scenario_id")
    @classmethod
    def validate_scenario(cls, v: str) -> str:
        if v not in VALID_SCENARIOS:
            raise ValueError(
                f"Invalid scenario_id '{v}'. "
                f"Must be one of: {sorted(VALID_SCENARIOS)}"
            )
        return v


class ScenarioResponse(BaseModel):
    status: str
    scenario_id: str
    scenario_label: str
    language: str
    demo_mode: bool
    grid_state: dict
    timestamp: str


# ---------------------------------------------------------------------------
# POST /scenario
# ---------------------------------------------------------------------------

@router.post("", response_model=ScenarioResponse)
async def inject_scenario(
    body: ScenarioRequest,
    settings: Settings = Depends(get_settings),
    engine: ScenarioEngine = Depends(get_scenario_engine),
    carbon: CarbonCalculator = Depends(get_carbon_calculator),
):
    """
    Activate a demo scenario.

    - Transitions the ScenarioEngine state machine.
    - Resets carbon counters for fresh session metrics.
    - Returns the resulting grid state immediately.

    DEMO_MODE=true  → serves synthetic scenario state.
    DEMO_MODE=false → injects into live GridEnv if available.
    """
    try:
        grid_state = engine.inject(body.scenario_id, body.language)
    except ValueError as exc:
        raise HTTPException(status_code=422, detail=str(exc))
    except Exception as exc:
        logger.exception("[scenario] Injection failed: %s", exc)
        raise HTTPException(status_code=500, detail="Scenario injection failed.")

    # Reset carbon counter so each scenario starts fresh
    carbon.reset()

    label = SCENARIO_LABELS.get(body.scenario_id, body.scenario_id)
    logger.info("[scenario] Activated: %s (%s)", body.scenario_id, body.language)

    return ScenarioResponse(
        status="ok",
        scenario_id=body.scenario_id,
        scenario_label=label,
        language=body.language,
        demo_mode=settings.demo_mode,
        grid_state=grid_state,
        timestamp=datetime.now(timezone.utc).isoformat(),
    )


# ---------------------------------------------------------------------------
# GET /scenario/list  (bonus — useful for frontend dropdown)
# ---------------------------------------------------------------------------

class ScenarioInfo(BaseModel):
    id: str
    label: str


@router.get("/list", response_model=list[ScenarioInfo])
async def list_scenarios():
    """Return all available scenario IDs and display labels."""
    return [
        ScenarioInfo(id=sid, label=label)
        for sid, label in SCENARIO_LABELS.items()
    ]
