# backend/services/scenario_engine.py
"""
GridMind — Scenario state machine.

Manages the active demo scenario, injects it into GridEnv,
and provides cached grid/decision state for DEMO_MODE.

Scenarios
---------
  normal              — baseline grid operation
  industrial_spike    — industrial load +42%
  storm               — solar/wind -78%, residential +15%
  battery_depletion   — battery SOC at critical 12%
  dual_failure        — wind offline + industrial spike

State machine transitions
-------------------------
  Any scenario → normal  (via reset)
  normal → any scenario  (via inject)
  active scenario → any scenario (override allowed)
"""

import json
import os
import threading
import time
from typing import Any, Dict, List, Optional

# ---------------------------------------------------------------------------
# Scenario presets — mirror grid_env.py SCENARIO_PRESETS exactly
# ---------------------------------------------------------------------------

VALID_SCENARIOS = {
    "normal",
    "industrial_spike",
    "storm",
    "battery_depletion",
    "dual_failure",
}

SCENARIO_LABELS = {
    "normal":             "Normal Operation",
    "industrial_spike":   "Industrial Demand Spike (+42%)",
    "storm":              "Storm Event (Solar/Wind -78%)",
    "battery_depletion":  "Battery Depletion (SOC 12%)",
    "dual_failure":       "Dual Failure (Wind Offline + Spike)",
}

# ---------------------------------------------------------------------------
# Synthetic demo grid state — used when DEMO_MODE=true or env unavailable
# ---------------------------------------------------------------------------

