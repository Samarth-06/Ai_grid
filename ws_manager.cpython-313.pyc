def _make_demo_decision(scenario_id: str) -> Dict:
    """Canned PPO decision for each scenario."""
    decisions = {
        "normal": {
            "action": {"route_industrial": 0.50, "route_residential": 0.50, "battery_cmd": 0.05},
            "reward": 0.91,
            "stability_score": 0.94,
            "carbon_reduction": 0.18,
            "brownout_risk": 0.02,
            "rationale": "Grid balanced. Minor battery top-up.",
        },
        "industrial_spike": {
            "action": {"route_industrial": 0.78, "route_residential": 0.45, "battery_cmd": -0.85},
            "reward": 0.74,
            "stability_score": 0.71,
            "carbon_reduction": 0.22,
            "brownout_risk": 0.18,
            "rationale": "Industrial spike detected. Rerouting load + discharging battery to prevent brownout.",
        },
        "storm": {
            "action": {"route_industrial": 0.42, "route_residential": 0.62, "battery_cmd": -0.92},
            "reward": 0.68,
            "stability_score": 0.66,
            "carbon_reduction": 0.09,
            "brownout_risk": 0.24,
            "rationale": "Renewable generation collapsed. Battery discharge prioritised. Substation load elevated.",
        },
        "battery_depletion": {
            "action": {"route_industrial": 0.38, "route_residential": 0.55, "battery_cmd": 0.15},
            "reward": 0.61,
            "stability_score": 0.63,
            "carbon_reduction": 0.14,
            "brownout_risk": 0.31,
            "rationale": "Battery critically low. Conserving remaining SOC. Load shedding risk if demand rises.",
        },
        "dual_failure": {
            "action": {"route_industrial": 0.88, "route_residential": 0.71, "battery_cmd": -1.0},
            "reward": 0.44,
            "stability_score": 0.42,
            "carbon_reduction": 0.06,
            "brownout_risk": 0.48,
            "rationale": "CRITICAL: Wind offline + industrial spike. Full battery discharge. Emergency rerouting active.",
        },
    }
    return decisions.get(scenario_id, decisions["normal"])


# ---------------------------------------------------------------------------
# Scenario Engine
# ---------------------------------------------------------------------------

class ScenarioEngine:
    """
    Thread-safe state machine for managing the active demo scenario.

    In DEMO_MODE the engine serves synthetic grid/decision state.
    In live mode it injects into a GridEnv instance.
    """

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._active_scenario: str = "normal"
        self._language: str = "en"
        self._tick: int = 0
        self._injected_at: float = time.time()
        self._grid_env = None          # set by main.py lifespan

    # ------------------------------------------------------------------
    # Wiring
    # ------------------------------------------------------------------

    def attach_env(self, grid_env) -> None:
        """Attach a live GridEnv for non-DEMO_MODE operation."""
        with self._lock:
            self._grid_env = grid_env

    # ------------------------------------------------------------------
    # State transitions
    # ------------------------------------------------------------------

    def inject(self, scenario_id: str, language: str = "en") -> Dict:
        """
        Activate a scenario. Returns the resulting grid state.

        Args:
            scenario_id: One of VALID_SCENARIOS.
            language: "en" | "kz" | "ru"

        Raises:
            ValueError: If scenario_id is not in VALID_SCENARIOS.
        """
        if scenario_id not in VALID_SCENARIOS:
            raise ValueError(
                f"Unknown scenario '{scenario_id}'. "
                f"Valid: {sorted(VALID_SCENARIOS)}"
            )

        with self._lock:
            self._active_scenario = scenario_id
            self._language = language
            self._tick = 0
            self._injected_at = time.time()

            if self._grid_env is not None:
                try:
                    self._grid_env.inject_scenario(scenario_id)
                except Exception:
                    pass  # fall through to demo state

        return self.get_grid_state()

    def reset(self) -> Dict:
        """Reset to normal operation."""
        return self.inject("normal", self._language)

    # ------------------------------------------------------------------
    # Reads
    # ------------------------------------------------------------------

    def tick(self) -> None:
        """Advance internal tick counter (called by WebSocket broadcaster)."""
        with self._lock:
            self._tick += 1

    def get_active_scenario(self) -> str:
        with self._lock:
            return self._active_scenario

    def get_language(self) -> str:
        with self._lock:
            return self._language

    def get_grid_state(self, demo_mode: bool = True) -> Dict:
        """
        Return current grid state dict.
        Always returns demo state (live env integration is via WebSocket).
        """
        with self._lock:
            scenario = self._active_scenario
            tick = self._tick

        state = _make_demo_state(scenario, tick)
        state["timestamp"] = _iso_now()
        state["demo_mode"] = demo_mode
        state["active_scenario"] = scenario
        state["scenario_label"] = SCENARIO_LABELS.get(scenario, scenario)
        return state

    def get_decision(self) -> Dict:
        """Return the current PPO decision for the active scenario."""
        with self._lock:
            scenario = self._active_scenario
        decision = _make_demo_decision(scenario)
        decision["scenario_id"] = scenario
        decision["timestamp"] = _iso_now()
        return decision

    def elapsed_seconds(self) -> float:
        with self._lock:
            return time.time() - self._injected_at


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _iso_now() -> str:
    from datetime import datetime, timezone
    return datetime.now(timezone.utc).isoformat()


# ---------------------------------------------------------------------------
# Module-level singleton
# ---------------------------------------------------------------------------

_engine: ScenarioEngine = ScenarioEngine()


def get_scenario_engine() -> ScenarioEngine:
    """FastAPI dependency — returns the process-wide singleton."""
    return _engine
